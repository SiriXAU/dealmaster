# Required — one or more Apprise notification URLs, comma-separated
# See https://github.com/caronc/apprise/wiki for all supported services
#
# Examples:
#   Discord:  discord://webhook_id/webhook_token
#   Slack:    slack://TokenA/TokenB/TokenC/Channel
#   Telegram: tgram://bottoken/ChatID
#   Email:    mailto://user:pass@gmail.com
APPRISE_URLS=discord://YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Optional — uncomment and adjust as needed
#CATEGORIES=Computing,Gaming
#KEYWORDS=Free,Steam,Epic Games
#POLL_INTERVAL_SECONDS=120
#MIN_VOTES=0
#MAX_SEEN_DEALS=500

# Optional gaming sources (all disabled by default)
# These can also be toggled from the web UI under "Gaming Sources"
#GAMERPOWER_ENABLED=false          # gamerpower.com API — all free giveaways
#GAMERPOWER_GAMES_ENABLED=false    # gamerpower.com API — full free games only
#GAMERPOWER_LOOT_ENABLED=false     # gamerpower.com API — loot & DLC only
#EPICBUNDLE_ENABLED=false          # epicbundle.com/feed — bundles & big promos
